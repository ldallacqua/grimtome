{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimtome",
  "version": "0.1.0",
  "identifier": "app.grimtome.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Grimtome",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "Grimtome Overlay",
        "url": "index.html?window=overlay",
        "width": 344,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/assets/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Grimtome contributors",
    "copyright": "© 2026 Grimtome contributors. Not affiliated with Blizzard Entertainment.",
    "category": "Utility",
    "shortDescription": "Diablo IV build companion and item advisor",
    "longDescription": "Grimtome reads Diablo IV item tooltips you capture and explains whether to keep, stash or salvage them for your leveling and endgame builds.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
